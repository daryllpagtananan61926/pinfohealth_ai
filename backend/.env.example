GEMINI_API_KEY=your-google-ai-studio-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Required in production. Defaults to http://localhost:5173 for local dev.
ALLOWED_ORIGIN=https://your-app.com
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Local dev: path to system prompt file (gitignored). Copy prompts/system-prompt.example.txt to this path.
# In production, this is ignored; the prompt is loaded from /etc/secrets/system-prompt.txt (Secret File mount).
SYSTEM_PROMPT_PATH=./prompts/system-prompt.txt